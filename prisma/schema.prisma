generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  password      String
  name          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  role          String          @default("USER")
  setupRequired Boolean         @default(false)
  contact       String?
  image         String?
  habits        Habit[]
  lifeLists     LifeList[]
  memories      Memory[]
  people        Person[]
  products      Product[]
  tickets       SupportTicket[]
}

model Product {
  id            String     @id @default(cuid())
  name          String
  token         String     @unique
  userId        String?
  createdAt     DateTime   @default(now())
  active        Boolean    @default(true)
  graduatedAt   DateTime?
  state         CharmState @default(ACTIVE)
  type          CharmType  @default(MEMORY)
  lastResetAt   DateTime?
  currentStreak Int        @default(0)
  longestStreak Int        @default(0)
  habits        Habit[]
  lifeLists     LifeList[]
  memories      Memory[]
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Memory {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  time        String?
  location    String?
  emotions    String[]
  mood        String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productId   String?
  events      String[]
  peopleIds   String[]
  isLiked     Boolean  @default(false)
  media       Media[]
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}

model Media {
  id         String   @id @default(cuid())
  url        String
  type       String
  memoryId   String
  createdAt  DateTime @default(now())
  size       Int      @default(0)
  orderIndex Int      @default(0)
  memory     Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

model LifeList {
  id          String         @id @default(cuid())
  name        String
  description String?
  template    String?
  productId   String
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  product     Product        @relation(fields: [productId], references: [id])
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       LifeListItem[]

  @@index([productId])
  @@index([userId])
}

model LifeListItem {
  id          String      @id @default(cuid())
  title       String
  description String?
  peopleIds   String[]
  whenType    String?
  targetDate  DateTime?
  status      String      @default("pending")
  livedAt     DateTime?
  lifeListId  String
  orderIndex  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  experience  Experience?
  lifeList    LifeList    @relation(fields: [lifeListId], references: [id], onDelete: Cascade)

  @@index([lifeListId])
}

model Person {
  id        String   @id @default(cuid())
  name      String
  avatarUrl String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Experience {
  id         String            @id @default(cuid())
  reflection String?
  location   String?
  date       DateTime
  peopleIds  String[]
  itemId     String            @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  isLiked    Boolean           @default(false)
  item       LifeListItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  media      ExperienceMedia[]
}

model ExperienceMedia {
  id           String     @id @default(cuid())
  url          String
  type         String
  size         Int        @default(0)
  experienceId String
  orderIndex   Int        @default(0)
  createdAt    DateTime   @default(now())
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Habit {
  id                    String     @id @default(cuid())
  title                 String
  description           String?
  focusArea             String
  frequency             String     @default("daily")
  targetDays            Int        @default(66)
  currentStreak         Int        @default(0)
  longestStreak         Int        @default(0)
  totalCompletions      Int        @default(0)
  isActive              Boolean    @default(true)
  graduatedAt           DateTime?
  archivedAt            DateTime?
  productId             String
  userId                String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  lastDeclinedUpgradeAt DateTime?
  level                 Int        @default(1)
  phase                 String     @default("initiation")
  resetAt               DateTime?
  ritualType            String     @default("OTHER")
  duration              Int?
  orderIndex            Int        @default(0)
  pauseUntil            DateTime?
  product               Product    @relation(fields: [productId], references: [id])
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs                  HabitLog[]

  @@index([productId])
  @@index([userId])
}

model HabitLog {
  id         String       @id @default(cuid())
  date       DateTime
  notes      String?
  reflection String?
  imageUrl   String?
  habitId    String
  createdAt  DateTime     @default(now())
  logType    HabitLogType @default(DONE)
  habit      Habit        @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, date])
}

model SupportTicket {
  id        String        @id @default(cuid())
  subject   String
  message   String
  status    SupportStatus @default(OPEN)
  email     String?
  userId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

enum HabitLogType {
  DONE
  SICK
  TRAVEL
  STRESSED
  BUSY
  OTHER
}

enum CharmType {
  MEMORY
  LIFE
  HABIT
}

enum CharmState {
  ACTIVE
  GRADUATED
  CLOSED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}
